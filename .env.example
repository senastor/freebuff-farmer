# =============================================================
# Freebuff GitHub Farmer — konfigurasi (.env)
# Salin file ini sebagai .env lalu isi nilainya.
# JANGAN commit .env ke git (sudah di-.gitignore).
# =============================================================

# --- IMAP Gmail (wajib) ---
# Dipakai untuk polling otomatis kode verifikasi GitHub yang dikirim ke inbox.
# App Password: https://myaccount.google.com/apppasswords (aktifkan 2FA dulu)
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_APP_PASSWORD=your_16_char_app_password

# --- Browser ---
# DISPLAY dipakai kalau mode headful di server (Xvfb). Contoh: :99
DISPLAY=:99
# true = headless (default), false = headful (butuh DISPLAY aktif)
HEADLESS=true